{
  "name": "MyFPT Next Jackpot Extension",
  "description": "Extension to automate MyFPT Next Jackpot number acquisition",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/logo.png"
  },
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://place.fpt.com/"],
      "js": ["scripts/runner.js"]
    }
  ]
}
