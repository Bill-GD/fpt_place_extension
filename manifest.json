{
  "name": "FPT Place Jackpot Helper",
  "description": "Extension to automate FPT Place Jackpot number acquisition",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/logo.png"
  },
  "permissions": ["storage", "tabs", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://place.fpt.com/*"],
      "js": ["scripts/runner.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["utils.js"],
      "matches": ["https://place.fpt.com/*"]
    }
  ]
}
